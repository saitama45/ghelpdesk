# Copy to .env.e2e and fill in. .env.e2e is gitignored — never commit real credentials.
E2E_BASE_URL=http://127.0.0.1:8010

# The tester: submits a QAT cycle for sign-off. Must NOT hold qat.approve.
E2E_TESTER_EMAIL=
E2E_TESTER_PASSWORD=

# The approving manager: must be the tester's manager in the org chart AND hold qat.approve.
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# A user with no qat.* permissions at all, for the 403 probes.
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=

# SQL Server backup, taken before any destructive run.
E2E_DB_HOST=127.0.0.1
E2E_DB_NAME=tashelpdeskdb
E2E_DB_USER=sa
E2E_DB_PASSWORD=
E2E_BACKUP_DIR=D:\\backups\\ghelpdesk-e2e
